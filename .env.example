# Copy to .env for local development. Real values live in Vercel and Railway env vars, never in git.

# SpacetimeDB: local by default. Production is wss://maincloud.spacetimedb.com with SPACETIME_DB=mesa.
SPACETIME_URI=ws://localhost:3000
SPACETIME_DB=mesa

# Console (Vite only exposes VITE_* to the browser)
VITE_SPACETIME_URI=ws://localhost:3000
VITE_SPACETIME_DB=mesa

# Service identities: tokens issued on first connect; set them so each service keeps one identity.
SIMULATOR_TOKEN=
AGENT_TOKEN=

# Agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PREDICTOR_URL=http://localhost:8000

# Optional voice escalation
ELEVENLABS_API_KEY=
