# Copy to .env for local development. Real values live in Vercel and Railway env vars, never in git.

# SpacetimeDB: local by default (database mesa).
# Production: SPACETIME_URI=wss://maincloud.spacetimedb.com and SPACETIME_DB=hackutd2026-0nef9.
SPACETIME_URI=ws://localhost:3000
SPACETIME_DB=mesa

# Console (Vite only exposes VITE_* to the browser)
VITE_SPACETIME_URI=ws://localhost:3000
VITE_SPACETIME_DB=mesa

# Service identities: tokens issued on first connect; set them so each service keeps one identity.
SIMULATOR_TOKEN=
AGENT_TOKEN=
# Telemetry replayer: optional fixed feed identity (otherwise saved in .replayer-tokens.json)
REPLAYER_TOKEN=
# Telemetry replayer speed: 1 = a batch every 10 s (default), 4 = every 2.5 s. --speed overrides it.
REPLAY_SPEED=

# Agent (services/agent): answers chat questions and writes incident/shift reports.
# After its first run, put the AGENT_TOKEN it prints above, then allow-list the identity it prints:
#   spacetime sql mesa "INSERT INTO agent_identity (identity) VALUES (0x<identity>)"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high: high lets Claude reason visibly (the console's thought-process panel), at more latency and cost
AGENT_EFFORT=high
LLM_TIMEOUT_MS=60000
MAX_LLM_CALLS_PER_MIN=20
PREDICTOR_URL=http://localhost:8000

# Optional voice escalation
ELEVENLABS_API_KEY=
